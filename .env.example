# LLM provider — curator uses Anthropic by default
ANTHROPIC_API_KEY=

# LLM config
LLM_PROVIDER=anthropic
# LLM_MODEL=        # defaults to claude-sonnet-4-6

# api-kaianolevine-com — internal API (Clerk M2M JWT auth — Project Keystone)
KAIANO_API_BASE_URL=
KAIANO_API_CLERK_MACHINE_SECRET=

# wcs-wiki repo — local clone path the curator writes to
WIKI_REPO_PATH=

# wcs-wiki repo — remote (for push). Defaults to origin if blank.
WIKI_REPO_REMOTE=origin

# Git author identity for curator commits
WIKI_GIT_AUTHOR_NAME=wiki-curator-cog
WIKI_GIT_AUTHOR_EMAIL=wiki-curator@kaianolevine.com

# Prefect Cloud
PREFECT_API_KEY=
PREFECT_API_URL=

# Observability
SENTRY_DSN_WIKI_CURATOR_COG=
HEALTHCHECKS_URL_WIKI_CURATOR_COG=
LOGGING_LEVEL=INFO

# Incremental-mode state file — where the curator persists last-run timestamp
WIKI_STATE_PATH=.wiki-curator-state.json

# Curator behavior tuning
WIKI_CURATOR_VERSION=1
WIKI_BACKFILL_PAGE_SIZE=100
