# ─────────────────────────────────────────────────────────────────────
# Required: upstream API
# ─────────────────────────────────────────────────────────────────────

# api-kaianolevine-com — internal API. This cog authenticates with its own
# named key (WIKI_CURATOR_COG_API_KEY); there is no fallback, so unset
# or wrong means 401 on every call. See ecosystem-standards CD-019.
KAIANO_API_BASE_URL=
WIKI_CURATOR_COG_API_KEY=YOUR_WIKI_CURATOR_COG_API_KEY

# ─────────────────────────────────────────────────────────────────────
# Required: wcs-wiki repo + git push credentials
# ─────────────────────────────────────────────────────────────────────

# Remote URL for the wcs-wiki repo. HTTPS form requires GH_TOKEN below.
# Defaults to the public github.com/mini-app-polis/wcs-wiki.git URL.
WIKI_REPO_URL=https://github.com/mini-app-polis/wcs-wiki.git

# Branch to commit and push to. A feature branch keeps a run's output
# reviewable as a PR rather than landing straight on main.
WIKI_BRANCH=phase-1-backfill

# Fine-grained GitHub PAT scoped to wcs-wiki only, with contents:write.
# Required when WIKI_REPO_URL starts with http(s)://. Never logged.
# Create at https://github.com/settings/personal-access-tokens/new
GH_TOKEN=

# Local path where the cog clones wcs-wiki at boot. Defaults to
# /tmp/wcs-wiki, which is appropriate for Railway. Override only for
# local development against an existing clone.
# WIKI_REPO_PATH=/tmp/wcs-wiki

# Git author identity used on every commit.
WIKI_GIT_AUTHOR_NAME=wiki-curator-cog
WIKI_GIT_AUTHOR_EMAIL=wiki-curator@kaianolevine.com

# Remote name for the configured URL. Effectively always 'origin'.
WIKI_REPO_REMOTE=origin

# ─────────────────────────────────────────────────────────────────────
# Optional: observability
# ─────────────────────────────────────────────────────────────────────

SENTRY_DSN_WIKI_CURATOR_COG=
HEALTHCHECKS_URL_WIKI_CURATOR_COG=
LOGGING_LEVEL=INFO

# Which environment this process is in. Railway injects
# RAILWAY_ENVIRONMENT_NAME ("production" or "development") and the resolver
# reads it, so this stays unset on a deployed service. It WINS over
# Railway's value when set.
ENVIRONMENT=local

# Base URL of api-kaianolevine-com. Production reads the unsuffixed name;
# every other environment reads KAIANO_API_BASE_URL_DEV (KAIANO_API_BASE_URL
# is declared above), with no fallback between them.
KAIANO_API_BASE_URL_DEV=

# Per-effect override. Unset is correct in both deployed environments.
# Set to true only for a deliberate end-to-end test, then remove it.
HEALTHCHECKS_ENABLED=

# ─────────────────────────────────────────────────────────────────────
# Optional: when a run happens, and how long it may take
# ─────────────────────────────────────────────────────────────────────

# Whether starting the container is, by itself, a request to rebuild the
# wiki. Unset means yes in production and no everywhere else — a
# development deploy is someone shipping code, and a run there would push
# to a branch of the real wcs-wiki. Set true to render from a development
# deploy; passing the `export` argument bypasses this entirely.
RUN_ON_START=

# How long one export may take before it is stopped deliberately, in
# seconds. Defaults to 600. It exists because Railway silently skips every
# later start while one is still Active, so a run that hangs takes all its
# successors with it.
RUN_TIMEOUT_SECONDS=

# How long the credential preflight and the Healthchecks ping may wait, in
# seconds. Defaults are 10 and 5. Both are here rather than inline so a test
# can zero them without touching source (TEST-013).
PUSH_PREFLIGHT_TIMEOUT_SECONDS=
HEALTHCHECKS_TIMEOUT_SECONDS=
