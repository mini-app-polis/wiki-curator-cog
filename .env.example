# ─────────────────────────────────────────────────────────────────────
# Required: upstream API
# ─────────────────────────────────────────────────────────────────────

# api-kaianolevine-com — internal API (Clerk M2M JWT auth — Project Keystone)
KAIANO_API_BASE_URL=
WIKI_CURATOR_COG_API_KEY=YOUR_WIKI_CURATOR_COG_API_KEY

# ─────────────────────────────────────────────────────────────────────
# Required: wcs-wiki repo + git push credentials
# ─────────────────────────────────────────────────────────────────────

# Remote URL for the wcs-wiki repo. HTTPS form requires GH_TOKEN below.
# Defaults to the public github.com/mini-app-polis/wcs-wiki.git URL.
WIKI_REPO_URL=https://github.com/mini-app-polis/wcs-wiki.git

# Branch to commit and push to. For the Phase 1 backfill, set this to
# a feature branch so the entire backfill lands in a PR you can review
# before merging. After Phase 1, override to 'main' for incremental.
WIKI_BRANCH=phase-1-backfill

# Fine-grained GitHub PAT scoped to wcs-wiki only, with contents:write.
# Required when WIKI_REPO_URL starts with http(s)://. Never logged.
# Create at https://github.com/settings/personal-access-tokens/new
GH_TOKEN=

# Local path where the cog clones wcs-wiki at boot. Defaults to
# /tmp/wcs-wiki, which is appropriate for Railway. Override only for
# local development against an existing clone.
# WIKI_REPO_PATH=/tmp/wcs-wiki

# Git author identity used on every commit.
WIKI_GIT_AUTHOR_NAME=wiki-curator-cog
WIKI_GIT_AUTHOR_EMAIL=wiki-curator@kaianolevine.com

# Remote name for the configured URL. Effectively always 'origin'.
WIKI_REPO_REMOTE=origin

# ─────────────────────────────────────────────────────────────────────
# Required: LLM (not yet used in Phase 1, but config.py validates the
# provider value, so set it). LLM-driven page updates land in Phase 1.5.
# ─────────────────────────────────────────────────────────────────────

ANTHROPIC_API_KEY=
LLM_PROVIDER=anthropic
# LLM_MODEL=        # defaults to claude-sonnet-4-6

# ─────────────────────────────────────────────────────────────────────
# Optional: Prefect Cloud
#
# Phase 1 backfill is invoked via the one-off CLI mode
# (`python -m wiki_curator_cog.main backfill`) and does NOT require
# Prefect Cloud. These vars are needed only once incremental_flow is
# triggered via the Prefect deployment registered by `serve()`.
# ─────────────────────────────────────────────────────────────────────

PREFECT_API_KEY=
PREFECT_API_URL=

# ─────────────────────────────────────────────────────────────────────
# Optional: observability
# ─────────────────────────────────────────────────────────────────────

SENTRY_DSN_WIKI_CURATOR_COG=
HEALTHCHECKS_URL_WIKI_CURATOR_COG=
LOGGING_LEVEL=INFO

# ─────────────────────────────────────────────────────────────────────
# Curator behavior tuning (defaults are fine for Phase 1)
# ─────────────────────────────────────────────────────────────────────

# Incremental-mode state file — where the curator persists last-run
# timestamp. Always curator-internal, never committed to the wiki.
WIKI_STATE_PATH=.wiki-curator-state.json

# Curator version is auto-derived from pyproject.toml via
# importlib.metadata (semantic-release bumps it on every release).
# Set this only as an escape hatch to force a specific version string
# during local dev or to manually trigger a re-render at a known label.
# WIKI_CURATOR_VERSION=

# Pagination size for /v1/wcs/notes/all during backfill.
WIKI_BACKFILL_PAGE_SIZE=100
