# wiki-curator-cog — the names this cog reads. Names only: the values live
# in Doppler (mini-app-polis-ecosystem / dev locally, prd for local runs
# against production) and, for the Lambda worker, in SSM. Run under
# `doppler run -- …`; do not copy this to .env — nothing reads it.
#
# Uncommented names are required in Doppler's dev config, and
# `uv run check-doppler-keys` checks dev holds every one. Commented names
# are optional: the code has a default.

# ─────────────────────────────────────────────────────────────────────
# Required: upstream API
# ─────────────────────────────────────────────────────────────────────

# api-kaianolevine-com — internal API. This cog authenticates with its own
# named key (WIKI_CURATOR_COG_API_KEY); there is no fallback, so unset
# or wrong means 401 on every call. See ecosystem-standards CD-019.
KAIANO_API_BASE_URL=
WIKI_CURATOR_COG_API_KEY=

# ─────────────────────────────────────────────────────────────────────
# Local commands only: the wcs-wiki clone
# ─────────────────────────────────────────────────────────────────────

# Path to your local wcs-wiki clone, for `render` and as the home of the
# .curator state cache. Not in Doppler: set it in your shell, and
# `doppler run` passes it through.
# WIKI_REPO_PATH=../wcs-wiki

# ─────────────────────────────────────────────────────────────────────
# Optional: observability
# ─────────────────────────────────────────────────────────────────────

# SENTRY_DSN_COGS=
# LOGGING_LEVEL=INFO

# Which environment this process is in. Doppler sets it per config
# (development in dev, production in prd).
# ENVIRONMENT=development

# Base URL of api-kaianolevine-com. Production reads the unsuffixed name;
# every other environment reads KAIANO_API_BASE_URL_DEV (KAIANO_API_BASE_URL
# is declared above), with no fallback between them.
KAIANO_API_BASE_URL_DEV=
